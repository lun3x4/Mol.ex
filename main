<script>
// ── SMILESDRAWER CONFIG (v1 API) ──────────────────────
const SD_OPTIONS = {
  width: 700, height: 520,
  bondThickness: 2.2,
  bondLength: 52,
  shortBondLength: 0.85,
  bondSpacing: 0.18,
  atomVisualization: 'default',
  isomeric: true,
  debug: false,
  terminalCarbons: false,
  explicitHydrogens: false,
  overlapSensitivity: 0.42,
  overlapResolutionIterations: 5,
  compactDrawing: false,
  fontSizeLarge: 14,
  fontSizeSmall: 10,
  padding: 28,
  themes: {
    custom: {
      C: '#111111', O: '#c84b2f', N: '#1a6bba',
      S: '#b8860b', P: '#8a2be2',
      F: '#2e8b57', CL: '#2e8b57', BR: '#8b2500', I: '#5f2d8a',
      BACKGROUND: '#f7f6f2',
    }
  }
};

function getDrawer(w, h) {
  return new SmilesDrawer.Drawer({ ...SD_OPTIONS, width: w, height: h });
}

// ── STATE ─────────────────────────────────────────────
let suggestTimeout = null;
let currentSMILES = null;
let activeSugIdx = -1;
let currentSuggestions = [];

// ── CLAUDE API — seul backend autorisé dans la sandbox ─
async function askClaude(userPrompt) {
  const res = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      model: 'claude-sonnet-4-20250514',
      max_tokens: 1000,
      system: `Tu es une base de données chimique. Réponds UNIQUEMENT en JSON valide, sans markdown, sans backticks, sans texte autour.
Format attendu :
{
  "found": true,
  "name": "Aspirin",
  "iupac": "2-acetyloxybenzoic acid",
  "formula": "C9H8O4",
  "smiles": "CC(=O)Oc1ccccc1C(=O)O",
  "molarMass": "180.158",
  "exactMass": "180.0423",
  "boilingPoint": "140 °C (décompose)",
  "meltingPoint": "135-136 °C",
  "density": "1.40 g/cm³",
  "solubility": "3 g/L (eau, 20°C)",
  "flashPoint": null,
  "logP": "1.19",
  "tpsa": "63.60",
  "hDonors": "1",
  "hAcceptors": "4",
  "rotatableBonds": "3",
  "heavyAtoms": "13",
  "pubchemCID": "2244"
}
Si la molécule est inconnue ou n'existe pas : { "found": false }
Pour les valeurs inconnues, mets null. Le SMILES doit être valide et isomeric si possible.`,
      messages: [{ role: 'user', content: userPrompt }]
    })
  });
  if (!res.ok) throw new Error(`API ${res.status}`);
  const data = await res.json();
  const text = data.content?.find(b => b.type === 'text')?.text ?? '';
  // Strip éventuel markdown
  const clean = text.replace(/```json|```/g, '').trim();
  return JSON.parse(clean);
}

async function askSuggestions(query) {
  const res = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      model: 'claude-sonnet-4-20250514',
      max_tokens: 200,
      system: `Tu es un moteur d'autocomplétion chimique. Réponds UNIQUEMENT en JSON : {"suggestions":["nom1","nom2",...]}
- 4 à 6 suggestions max, noms communs en anglais ou latin chimique
- Inclure le nom tapé (corrigé si besoin) et des synonymes courants
- Aucun texte hors du JSON`,
      messages: [{ role: 'user', content: `Suggestions pour : "${query}"` }]
    })
  });
  if (!res.ok) return [];
  const data = await res.json();
  const text = data.content?.find(b => b.type === 'text')?.text ?? '';
  const clean = text.replace(/```json|```/g, '').trim();
  const parsed = JSON.parse(clean);
  return parsed.suggestions ?? [];
}

// ── AUTOCOMPLETE ──────────────────────────────────────
const searchInput = document.getElementById('searchInput');
const suggestionsEl = document.getElementById('suggestions');

searchInput.addEventListener('input', () => {
  clearTimeout(suggestTimeout);
  const val = searchInput.value.trim();
  if (val.length < 2) { hideSuggestions(); return; }
  suggestTimeout = setTimeout(() => loadSuggestions(val), 350);
});

searchInput.addEventListener('keydown', e => {
  if (e.key === 'ArrowDown') {
    activeSugIdx = Math.min(activeSugIdx + 1, currentSuggestions.length - 1);
    highlightSuggestion(); e.preventDefault();
  } else if (e.key === 'ArrowUp') {
    activeSugIdx = Math.max(activeSugIdx - 1, -1);
    highlightSuggestion(); e.preventDefault();
  } else if (e.key === 'Enter') {
    if (activeSugIdx >= 0 && currentSuggestions[activeSugIdx]) {
      selectSuggestion(currentSuggestions[activeSugIdx]);
    } else {
      doSearch(searchInput.value.trim());
    }
    hideSuggestions();
  } else if (e.key === 'Escape') {
    hideSuggestions();
  }
});

document.addEventListener('click', e => {
  if (!e.target.closest('.search-wrap')) hideSuggestions();
});

async function loadSuggestions(query) {
  try {
    const terms = await askSuggestions(query);
    currentSuggestions = terms;
    activeSugIdx = -1;
    if (!terms.length) { hideSuggestions(); return; }

    suggestionsEl.innerHTML = '';
    terms.forEach(term => {
      const div = document.createElement('div');
      div.className = 'suggestion-item';
      div.textContent = term;
      div.addEventListener('mousedown', e => {
        e.preventDefault();
        selectSuggestion(term);
      });
      suggestionsEl.appendChild(div);
    });
    suggestionsEl.classList.add('visible');
  } catch { hideSuggestions(); }
}

function highlightSuggestion() {
  suggestionsEl.querySelectorAll('.suggestion-item').forEach((el, i) => {
    el.classList.toggle('active', i === activeSugIdx);
  });
  if (activeSugIdx >= 0 && currentSuggestions[activeSugIdx]) {
    searchInput.value = currentSuggestions[activeSugIdx];
  }
}

function selectSuggestion(term) {
  searchInput.value = term;
  hideSuggestions();
  doSearch(term);
}

function hideSuggestions() {
  suggestionsEl.classList.remove('visible');
}

// ── QUICK SEARCH (pilules) ────────────────────────────
function quickSearch(query, displayHint) {
  searchInput.value = displayHint || query;
  doSearch(query, displayHint);
}

// ── MAIN SEARCH ───────────────────────────────────────
async function doSearch(query, forceDisplayName) {
  if (!query) return;
  hideSuggestions();
  showLoader(true);
  hideCard();
  hideError();
  hideEmpty();

  try {
    const prompt = forceDisplayName
      ? `Donne-moi les données chimiques complètes pour : "${query}" (aussi connu en français sous le nom "${forceDisplayName}")`
      : `Donne-moi les données chimiques complètes pour : "${query}"`;

    const mol = await askClaude(prompt);

    if (!mol.found) throw new Error('not found');

    renderMolecule(mol, forceDisplayName);

  } catch (err) {
    showError();
  } finally {
    showLoader(false);
  }
}

// ── RENDER ────────────────────────────────────────────
function renderMolecule(mol, forceDisplayName) {
  const card = document.getElementById('molCard');

  document.getElementById('molName').textContent = forceDisplayName || mol.name;
  document.getElementById('molFormula').textContent = mol.formula ?? '—';
  document.getElementById('molIupac').textContent = mol.iupac ? `IUPAC: ${mol.iupac}` : '';
  document.getElementById('smilesText').textContent = mol.smiles ?? '';

  const cid = mol.pubchemCID;
  document.getElementById('pubchemLink').href = cid
    ? `https://pubchem.ncbi.nlm.nih.gov/compound/${cid}`
    : `https://pubchem.ncbi.nlm.nih.gov/#query=${encodeURIComponent(mol.name)}`;

  // Build props grid
  const propsGrid = document.getElementById('propsGrid');
  propsGrid.innerHTML = '';

  const propItems = [
    { label: 'Masse molaire',         value: mol.molarMass,      unit: 'g/mol', accent: true },
    { label: 'Masse exacte',          value: mol.exactMass,      unit: 'Da' },
    { label: 'Temp. de fusion',       value: mol.meltingPoint,   unit: '' },
    { label: "Temp. d'ébullition",    value: mol.boilingPoint,   unit: '' },
    { label: 'Point d\'éclair',       value: mol.flashPoint,     unit: '' },
    { label: 'Densité',               value: mol.density,        unit: '' },
    { label: 'LogP (lipophilicité)',  value: mol.logP,           unit: '' },
    { label: 'Surface polaire',       value: mol.tpsa,           unit: 'Å²' },
    { label: 'Donneurs H',            value: mol.hDonors,        unit: '' },
    { label: 'Accepteurs H',          value: mol.hAcceptors,     unit: '' },
    { label: 'Liaisons rotatives',    value: mol.rotatableBonds, unit: '' },
    { label: 'Atomes lourds',         value: mol.heavyAtoms,     unit: '' },
    { label: 'Solubilité',            value: mol.solubility,     unit: '' },
  ].filter(p => p.value != null && p.value !== '' && p.value !== 'null');

  propItems.forEach(item => {
    const cell = document.createElement('div');
    cell.className = 'prop-cell';
    cell.innerHTML = `
      <div class="prop-label">${item.label}</div>
      <div class="prop-value${item.accent ? ' accent' : ''}">${item.value}${item.unit ? `<span class="prop-unit"> ${item.unit}</span>` : ''}</div>
    `;
    propsGrid.appendChild(cell);
  });

  // Afficher la carte AVANT drawStructure (pour que clientWidth soit valide)
  card.style.display = 'block';
  document.getElementById('searchSection').classList.add('has-result');

  // Dessiner après un frame pour que le layout soit calculé
  currentSMILES = mol.smiles;
  requestAnimationFrame(() => {
    drawStructure(mol.smiles, document.getElementById('canvasWrap'));
    setTimeout(() => card.scrollIntoView({ behavior: 'smooth', block: 'start' }), 80);
  });
}

// ── STRUCTURE DRAWING ─────────────────────────────────
function drawStructure(smiles, wrap) {
  const canvas = document.getElementById('molCanvas');
  const noStructEl = document.getElementById('noStructure');

  if (!smiles) {
    canvas.style.display = 'none';
    noStructEl.style.display = 'flex';
    return;
  }

  canvas.style.display = 'block';
  noStructEl.style.display = 'none';

  const W = Math.max(wrap.clientWidth - 2, 300);
  const H = Math.min(Math.round(W * 3 / 4), 420);
  canvas.width = W;
  canvas.height = H;

  try {
    const drawer = getDrawer(W, H);
    SmilesDrawer.parse(smiles, tree => {
      drawer.draw(tree, canvas, 'custom', false);
    }, err => {
      console.warn('SMILES parse:', err);
      canvas.style.display = 'none';
      noStructEl.style.display = 'flex';
    });
  } catch (e) {
    console.warn('Draw error:', e);
    canvas.style.display = 'none';
    noStructEl.style.display = 'flex';
  }
}

// ── UI HELPERS ────────────────────────────────────────
function showLoader(v) {
  document.getElementById('loader').style.display = v ? 'block' : 'none';
}
function hideCard() {
  document.getElementById('molCard').style.display = 'none';
  document.getElementById('searchSection').classList.remove('has-result');
}
function showError() { document.getElementById('errorMsg').style.display = 'block'; }
function hideError() { document.getElementById('errorMsg').style.display = 'none'; }
function hideEmpty() { document.getElementById('emptyState').style.display = 'none'; }

// ── RESIZE ────────────────────────────────────────────
let resizeTimer;
window.addEventListener('resize', () => {
  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(() => {
    if (currentSMILES) drawSt
